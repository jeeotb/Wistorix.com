let dragSrc = null;
function dragElOf(host){
  const id = host && host.dataset ? host.dataset.dragid : '';
  if(!id) return null;
  return id.charAt(0)==='b' ? blockReg.get(id.slice(2)) : secReg.get(id.slice(2));
}
function clearDropMarks(root){ root.querySelectorAll('.dz-before,.dz-after').forEach(n=>n.classList.remove('dz-before','dz-after')); }
function wireDrag(root){
  root.querySelectorAll('[data-drag]').forEach(h=>{
    h.setAttribute('draggable','true');
    h.addEventListener('dragstart', e=>{
      const host = h.closest('[data-dragid]'); const el = dragElOf(host);
      if(!host || !el){ e.preventDefault(); return; }
      dragSrc = {host, el};
      host.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      try{ e.dataTransfer.setData('text/plain', host.dataset.dragid); }catch(_){}
      e.stopPropagation();
    });
    h.addEventListener('dragend', ()=>{
      clearDropMarks(root);
      if(dragSrc && dragSrc.host) dragSrc.host.classList.remove('dragging');
      dragSrc = null;
    });
  });
  root.querySelectorAll('[data-dragid]').forEach(host=>{
    const okTarget = ()=>{
      if(!dragSrc) return null;
      const t = dragElOf(host);
      if(!t || t===dragSrc.el) return null;
      if(t.parentNode !== dragSrc.el.parentNode) return null;   // chi cho doi cho trong cung cha
      return t;
    };
    host.addEventListener('dragover', e=>{
      const t = okTarget(); if(!t) return;
      e.preventDefault(); e.stopPropagation();
      e.dataTransfer.dropEffect = 'move';
      const r = host.getBoundingClientRect();
      const after = (e.clientY - r.top) > r.height/2;
      clearDropMarks(root);
      host.classList.add(after ? 'dz-after' : 'dz-before');
    });
    host.addEventListener('drop', e=>{
      const t = okTarget(); if(!t) return;
      e.preventDefault(); e.stopPropagation();
      const r = host.getBoundingClientRect();
      const after = (e.clientY - r.top) > r.height/2;
      const moved = dragSrc.el;
      t.parentNode.insertBefore(moved, after ? t.nextSibling : t);
      clearDropMarks(root);
      if(dragSrc.host) dragSrc.host.classList.remove('dragging');
      dragSrc = null;
      afterStructural('Đã đổi vị trí ✓');
    });
  });
}
