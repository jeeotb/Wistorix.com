function resetField(it,f){
  if(it.kind==='image'){ it.pendingFile=null; it.pendingURL=null; it.value=it.original; it.changed=false;
    if(it.el) it.el.setAttribute('src', it.original); }
  else { if(it.mode==='rich') it.el.innerHTML=it.original; else setText(it, it.original); it.value=it.original; it.changed=false; markSlot(it); }
  f.classList.remove('changed'); recomputeDirty(it.page);
  if(it.kind==='image') renderPreview(); else livePreview(it);   // full rebuild restores original srcset
