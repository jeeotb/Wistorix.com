  if($('#search').value.trim()) $('#search').value='';   // clear filter so the field is present
  pendingOpenUid = it.uid;                       // render it already open
  renderFields();
  const node = document.querySelector('.tnode[data-uid="'+it.uid+'"]');
  if(!node) return;
  node.classList.add('open');
  node.scrollIntoView({behavior:'smooth', block:'center'});
  node.classList.remove('flash'); void node.offsetWidth; node.classList.add('flash');
  const inp = node.querySelector('textarea,.rich-ed'); if(inp) inp.focus({preventScroll:true});
}
// Live, instant update of a single node inside the loaded preview (no reload)
// Point an <img> at a new source. Responsive images use srcset over src, so we must
// clear srcset/sizes (and any <picture><source>) or the old image keeps showing.
function applyImageSrc(node, url){
  if(!node) return;
  node.setAttribute('src', url);
  node.removeAttribute('srcset');
  node.removeAttribute('sizes');
  const par = node.parentElement;
  if(par && par.tagName === 'PICTURE') par.querySelectorAll('source').forEach(s=>s.remove());
}
function livePreview(it){
  const d = $('#preview').contentDocument; if(!d) return;
  const n = d.querySelector('[data-se="'+it.seid+'"]'); if(!n) return;
  if(it.cat==='img') applyImageSrc(n, it.pendingURL || it.value);
  else if(it.cat==='ph') n.setAttribute('placeholder', it.value);
  else if(it.mode==='textnode') n.textContent = it.value;
  else n.innerHTML = it.el.innerHTML;   // plain (may hold <br>) or rich markup
}
function schedulePreview(){ /* kept for compatibility; live updates are instant */ }

/* ============================ dirty + save ============================ */
function markDirty(page){ page.dirty=true; refreshDirtyUI(); }
function recomputeDirty(page){ page.dirty = page.items.some(i=>i.changed); refreshDirtyUI(); }
function refreshDirtyUI(){
  const anyDirty = state.pages.some(p=>p.dirty);
  $('#saveBtn').disabled = !anyDirty;
  const n = state.pages.reduce((a,p)=>a+p.items.filter(i=>i.changed).length,0);
  if(anyDirty) setStatus('dirty', n+' thay đổi chưa lưu');
  else setStatus('saved','Đã lưu — khớp với file');
  document.querySelectorAll('.pagelink').forEach(a=>{
    const p=state.pages.find(x=>x.name===a.dataset.page);
    let b=a.querySelector('.badge');
    if(p&&p.dirty){ if(!b){ b=document.createElement('span'); b.className='badge'; b.textContent='•'; a.insertBefore(b,a.querySelector('.cnt')); } }
    else if(b) b.remove();
  });
  // nhom blog dang gap van phai bao co bai chua luu
  const gh = document.querySelector('#blogGroupHead');
  if(gh){
    const gDirty = state.pages.some(p=>isBlogPost(p.name) && p.dirty);
    let b = gh.querySelector('.badge');
    if(gDirty){ if(!b){ b=document.createElement('span'); b.className='badge'; b.textContent='•'; gh.insertBefore(b, gh.querySelector('.cnt')); } }
    else if(b) b.remove();
  }
}
function setStatus(kind,txt){ const s=$('#status'); s.className='status '+kind; s.querySelector('.txt').textContent=txt; }

async function saveAll(){
  const dirtyPages = state.pages.filter(p=>p.dirty);
  if(!dirtyPages.length) return;
  // make sure shared edits propagated
  for(const p of state.pages) for(const it of p.items) if(it.changed && it.shared) propagateShared(it);
  $('#saveBtn').disabled=true; setStatus('dirty','Đang lưu…');
  try{
    // 1) upload any new images, set final src in the docs
    for(const p of state.pages){
      for(const it of p.items){
        if(it.kind==='image' && it.pendingFile){
          const b64 = await fileToBase64(it.pendingFile);
          const r = await fetch('/__api/save-image',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({name:it.pendingFile.name, dataBase64:b64, subdir:guessSubdir(it.original)})});
          const j = await r.json(); if(!j.ok) throw new Error(j.error||'upload ảnh lỗi');
          applyImageSrc(it.el, j.path); it.value=j.path; it.original=j.path;
          it.pendingFile=null; if(it.pendingURL){URL.revokeObjectURL(it.pendingURL);it.pendingURL=null;}
          markDirty(p);
        }
      }
    }
    // 2) write each dirty page
    let saved=0;
    for(const p of state.pages.filter(x=>x.dirty)){
      const html = '<!DOCTYPE html>\n'+p.doc.documentElement.outerHTML;
      const r = await fetch('/__api/save',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({file:p.name, html})});
      const j = await r.json(); if(!j.ok) throw new Error(j.error||('lưu '+p.name+' lỗi'));
      p.dirty=false; p.items.forEach(i=>{ i.original = i.kind==='image'?i.value:getText(i); i.changed=false; }); saved++;
    }
    buildSharedIndex();
    refreshDirtyUI(); renderFields($('#search').value.trim().toLowerCase()||null); renderPreview();
    toast('Đã lưu '+saved+' trang vào file ✓ (bản gốc nằm trong thư mục _editor_backup)');
    setStatus('saved','Đã lưu vào file');
  }catch(e){ toast('Lỗi: '+e.message, true); setStatus('dirty','Lưu chưa xong'); $('#saveBtn').disabled=false; }
}
function guessSubdir(src){ const m=/^(images|assets|img|media|fonts)\b/i.exec(src.replace(/^\.?\//,'')); return m?m[1].toLowerCase():'images'; }
function fileToBase64(file){ return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsDataURL(file); }); }

/* ============================ misc ============================ */
function toast(msg,err){ const t=$('#toast'); t.textContent=msg; t.className='show'+(err?' err':''); clearTimeout(t._t); t._t=setTimeout(()=>t.className='',4200); }
$('#saveBtn').onclick=saveAll;
$('#search').addEventListener('input', e=>{ if(state.active) renderFields(e.target.value.trim().toLowerCase()||null); });
/* ---- draggable divider (widen/narrow the preview) ---- */
(function initResize(){
  const g=$('#gutter'), app=document.querySelector('.app'), root=document.documentElement;
  function onMove(e){
    const rect=app.getBoundingClientRect();
    let w = rect.right - e.clientX;                 // preview width
    w = Math.max(300, Math.min(app.clientWidth-470, w));
    root.style.setProperty('--pw', w+'px'); fitPreview();
  }
  function stop(){ document.body.classList.remove('resizing'); g.classList.remove('drag');
    window.removeEventListener('pointermove',onMove); window.removeEventListener('pointerup',stop); }
  g.addEventListener('pointerdown', e=>{ e.preventDefault(); g.classList.add('drag'); document.body.classList.add('resizing');
    window.addEventListener('pointermove',onMove); window.addEventListener('pointerup',stop); });
  g.addEventListener('dblclick', ()=>{ root.style.setProperty('--pw','40vw'); fitPreview(); });   // reset
})();
window.addEventListener('resize', fitPreview);
$('#previewToggle').onclick=()=>{ document.querySelector('.app').classList.toggle('no-preview'); setTimeout(fitPreview,30); };
window.addEventListener('beforeunload', e=>{ if(state.pages.some(p=>p.dirty)){ e.preventDefault(); e.returnValue=''; } });
document.addEventListener('input', e=>{ // propagate shared while typing (debounced by browser)
  const f=e.target.closest && e.target.closest('.field'); if(!f) return;
  const it=findItem(f.dataset.uid); if(!it) return;
  const node=e.target.closest('.tnode'); if(node) node.classList.toggle('changed', it.changed);   // live "edited" dot on the tree
  if(it.changed&&it.shared) propagateShared(it);
});
function _scBoxes(page){return page&&page.doc?Array.from(page.doc.querySelectorAll('[data-optional-box="sua-chua"]')):[];}function _scAllHidden(){let any=false,all=true;for(const p of state.pages){for(const el of _scBoxes(p)){any=true;if(el.style.display!=="none")all=false;}}return any&&all;}function _scUpdateBtn(){const b=document.querySelector("#hideRepairBtn");if(!b)return;const cnt=state.pages.reduce((a,p)=>a+_scBoxes(p).length,0);b.style.display=cnt?"":"none";const hidden=_scAllHidden();b.classList.toggle("active",hidden);const l=b.querySelector(".lbl");if(l)l.textContent=hidden?"Hiện Sửa chữa":"Ẩn Sửa chữa";}function _scToggle(){const hide=!_scAllHidden();for(const p of state.pages){const boxes=_scBoxes(p);if(!boxes.length)continue;boxes.forEach(el=>{if(hide)el.style.setProperty("display","none","important");else el.style.removeProperty("display");});markDirty(p);}_scUpdateBtn();renderPreview();}var _scb=document.querySelector("#hideRepairBtn");if(_scb)_scb.onclick=_scToggle;

boot();
</script>
