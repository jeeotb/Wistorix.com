/* ---------- structural ops: nhan ban / an / xoa / doi thu tu ---------- */
function afterStructural(msg){
  const p = state.active; if(!p) return;
  markDirty(p);
  p.items = extract(p);          // quet lai trang sau khi doi cau truc
  buildSharedIndex();
  renderFields($('#search').value.trim().toLowerCase()||null);
  renderPreview();
  if(msg) toast(msg);
}
function blockOp(op, el, what){
  const p = state.active; if(!p || !el || !el.parentNode) return;
  const name = what || 'khối này';
  if(op==='del' || op==='hide'){
    // luoi an toan doc lap voi cay: khong bao gio cho mot thao tac nuot gan het trang
    const docLen = (p.doc.body && p.doc.body.innerHTML.length) || 1;
    if(el.outerHTML.length > docLen*0.6){
      alert('Khối này chiếm gần như toàn bộ trang nên không thao tác được.\n\nHãy mở khu vực ra rồi ẩn/xoá từng khối nhỏ bên trong.');
      return;
    }
  }
  if(op==='del'){
    if(!confirm('Xoá hẳn '+name+' khỏi trang?\n\nMuốn lấy lại được thì dùng nút 👁 Ẩn thay vì xoá.')) return;
    el.remove();
  }
  else if(op==='hide'){ hideEl(p.doc, el, (what && what!=='khối này') ? what : blockLabel(el)); }
  else if(op==='dup'){ const c=el.cloneNode(true); el.parentNode.insertBefore(c, el.nextSibling); }
  else if(op==='up'){ const prev=el.previousElementSibling; if(!prev){ toast('Đã ở đầu nhóm'); return; } el.parentNode.insertBefore(el, prev); }
  else if(op==='down'){ const next=el.nextElementSibling; if(!next){ toast('Đã ở cuối nhóm'); return; } el.parentNode.insertBefore(next, el); }
  afterStructural(op==='dup'?'Đã nhân bản ✓':op==='del'?'Đã xoá ✓':op==='hide'?'Đã ẩn ✓ — bật lại ở bảng "Đang ẩn"':'Đã đổi thứ tự ✓');
}

