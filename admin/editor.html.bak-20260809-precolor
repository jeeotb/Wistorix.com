// Build a faithful preview: clone the real page (keeps all CSS + scripts/animations),
// tag every editable target so we can update it live, and load it via srcdoc.
function buildPreviewHTML(page){
  const clone = page.doc.cloneNode(true);
  const T = collectTargets(clone);
  T.texts.forEach((t,i)=>{
    if(t.mode!=='textnode'){ t.node.setAttribute('data-se','t'+i); }
    else { const sp=clone.createElement('span'); sp.setAttribute('data-se','t'+i);
           t.node.parentNode.replaceChild(sp, t.node); sp.appendChild(t.node); }
  });
  T.imgs.forEach((img,i)=> img.setAttribute('data-se','g'+i));
  T.phs.forEach((inp,i)=> inp.setAttribute('data-se','p'+i));
  // reflect any not-yet-saved image choices
  for(const it of page.items){ if(it.cat==='img' && it.pendingURL){ applyImageSrc(clone.querySelector('[data-se="'+it.seid+'"]'), it.pendingURL); } }
  // correct relative asset paths regardless of page location
  const dir = page.name.includes('/') ? '/'+page.name.slice(0, page.name.lastIndexOf('/')+1) : '/';
  const head = clone.querySelector('head');
  if(head && !head.querySelector('base')){ const b=clone.createElement('base'); b.setAttribute('href', dir); head.insertBefore(b, head.firstChild); }
  return '<!DOCTYPE html>'+clone.documentElement.outerHTML;
}
const PREVIEW_DESIGN_W = 1280;                 // render at desktop width, then scale to fit the pane
function fitPreview(){
  const stage = $('#pstage'); if(!stage) return;
  const w = stage.clientWidth, h = stage.clientHeight;
  if(w < 40){ return; }
  const scale = w / PREVIEW_DESIGN_W;
  const ifr = $('#preview');
  ifr.style.width = PREVIEW_DESIGN_W + 'px';
  ifr.style.height = (h / scale) + 'px';
  ifr.style.transform = 'scale(' + scale + ')';
}
function renderPreview(){
  const p = state.active; if(!p) return;
  const ifr = $('#preview');
  ifr.onload = ()=>{ fitPreview(); wirePreviewInteractions(); };
  ifr.srcdoc = buildPreviewHTML(p);
  fitPreview();
}
// Resolve which editable element is under a click point, even through overlays or
// pointer-events:none images: try normal hit-test first, then geometry (smallest box containing the point).
function seFromPoint(d, x, y){
  // Many decorative images have pointer-events:none, so hit-testing skips them.
  // Temporarily enable it on tagged images, then read the real stacking order at the point.
  const imgs = d.querySelectorAll ? Array.from(d.querySelectorAll('img[data-se]')) : [];
  const saved = imgs.map(i=>i.style.pointerEvents);
  imgs.forEach(i=>{ i.style.pointerEvents = 'auto'; });
  let found = null;
  const stack = d.elementsFromPoint ? d.elementsFromPoint(x, y) : [];
  for(const el of stack){ const m = el.closest && el.closest('[data-se]'); if(m){ found = m; break; } }
  imgs.forEach((i,k)=>{ i.style.pointerEvents = saved[k]; });
  if(found) return found;
  // last resort: smallest tagged box that contains the point
  let scope = (d.elementFromPoint && d.elementFromPoint(x,y)) || d.body, best=null, bestArea=Infinity, hops=0;
  while(scope && hops < 6){
    for(const c of (scope.querySelectorAll ? scope.querySelectorAll('[data-se]') : [])){
      const r = c.getBoundingClientRect();
      if(x>=r.left && x<=r.right && y>=r.top && y<=r.bottom){ const a=r.width*r.height; if(a<bestArea){ bestArea=a; best=c; } }
    }
    if(best) return best; scope = scope.parentElement; hops++;
  }
  return null;
}
// Click any element in the preview -> find & highlight its edit box
function wirePreviewInteractions(){
  const d = $('#preview').contentDocument; if(!d) return;
  if(!d.getElementById('__se_style')){
    const st = d.createElement('style'); st.id='__se_style';
    st.textContent = '[data-se]{cursor:pointer}[data-se]:hover{outline:2px dashed #0740C1;outline-offset:2px;background:rgba(7,64,193,.06)}[data-se].__se_hit{outline:3px solid #0740C1 !important;outline-offset:2px}';
    (d.head||d.documentElement).appendChild(st);
  }
  d.addEventListener('click', e=>{
    let t = e.target && e.target.closest ? e.target.closest('[data-se]') : null;
    if(!t) t = seFromPoint(d, e.clientX, e.clientY);   // pierce overlays / pointer-events:none images
    if(!t) return;
    const a = e.target.closest && e.target.closest('a'); if(a) e.preventDefault();   // don't navigate away
    const seid = t.getAttribute('data-se');
    t.classList.add('__se_hit'); setTimeout(()=>t.classList.remove('__se_hit'), 1000);
    locateField(seid);
  }, true);
}
function locateField(seid){
  const p = state.active; if(!p) return;
  const it = p.items.find(x=>x.seid===seid); if(!it) return;
