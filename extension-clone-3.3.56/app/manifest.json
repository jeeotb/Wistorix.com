{
   "action": {
      "default_icon": {
         "128": "assets/icons/wistorix-icon-128.png",
         "16": "assets/icons/wistorix-icon-16.png",
         "48": "assets/icons/wistorix-icon-48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Manage Google Drive files, visualize storage statistics, and clean up unused files.",
   "host_permissions": [ "https://www.googleapis.com/*", "https://www.google-analytics.com/*", "https://accounts.google.com/*", "https://us-central1-wistorix.cloudfunctions.net/*" ],
   "icons": {
      "128": "assets/icons/wistorix-icon-128.png",
      "16": "assets/icons/wistorix-icon-16.png",
      "48": "assets/icons/wistorix-icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Wistorix",
   "oauth2": {
      "client_id": "172477157648-n73onb707j7r1p65dqjt8g0k3kqe632d.apps.googleusercontent.com",
      "scopes": [ "openid", "email", "profile", "https://www.googleapis.com/auth/spreadsheets", "https://www.googleapis.com/auth/gmail.send", "https://www.googleapis.com/auth/drive", "https://www.googleapis.com/auth/userinfo.email" ]
   },
   "options_page": "dashboard.html",
   "permissions": [ "identity", "storage", "alarms", "unlimitedStorage", "notifications" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.3.56",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "assets/UI/*", "assets/UI/states/*", "assets/UI/loading/*", "assets/icons/*" ]
   } ]
}
